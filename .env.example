# Copialo como .env y completalo. Nunca lo subas al repo.

# URL pública, sin barra final. Se usa para armar los links personales.
BASE_URL=https://juntada.midominio.com
PORT=3000

# Token del panel /admin (mínimo 12 caracteres). Generalo con: openssl rand -base64 24
ADMIN_TOKEN=cambiame-por-algo-largo-y-random

# La votación: título y rango de días que se pueden elegir (YYYY-MM-DD, inclusive)
EVENT_TITLE=¿Cuándo nos juntamos?
START_DATE=2026-11-02
END_DATE=2026-12-20
# Código de país que se antepone a los números sin prefijo (595 = Paraguay)
DEFAULT_COUNTRY_CODE=595

# Cookies "Secure": vacío = automático según BASE_URL; o true / false
COOKIE_SECURE=

# Sólo para deploy/docker-compose.vps.yml (detrás de nginx-proxy): dominio para
# VIRTUAL_HOST y el certificado de Let's Encrypt
DOMAIN=

# Bot de WhatsApp (opcional, contenedor "bot"). Token compartido entre la app y
# el bot (mínimo 16 caracteres); generalo con: openssl rand -hex 32
BOT_WEBHOOK_TOKEN=
BOT_MAX_PER_HOUR=60
# BOT_WEBHOOK_URL lo fija docker-compose (http://bot:3100/send). Solo hace falta
# definirlo si corrés la app sin Docker. Si queda vacío, no hay bot: los links se
# mandan con el botón "📲 WhatsApp" del panel y no hay login por código.
# BOT_WEBHOOK_URL=
# Opcional: número del chip (ej. 595981123456) para vincular con código en vez de QR
BOT_PAIR_PHONE=
