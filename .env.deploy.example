# Config de scripts/deploy-vps.sh. Copialo como .env.deploy (no se commitea).
# Alias de ~/.ssh/config o usuario@host
DEPLOY_HOST=usuario@mi-vps
# Carpeta en el servidor, relativa al home
DEPLOY_DIR=apps/juntada
# Dominio público (el mismo que DOMAIN en el .env del servidor)
DEPLOY_DOMAIN=juntada.midominio.com
# Nombre del contenedor de nginx-proxy en el servidor
PROXY_CONTAINER=nginx-proxy
